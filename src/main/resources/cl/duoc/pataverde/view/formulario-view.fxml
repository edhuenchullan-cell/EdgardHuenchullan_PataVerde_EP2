<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8.0" prefWidth="350.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cl.duoc.pataverde.controller.FormularioController">
    <padding><Insets top="15.0" right="15.0" bottom="15.0" left="15.0" /></padding>

    <Label text="Registrar mascota" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <Label text="Tipo:" />
    <ComboBox fx:id="cmbTipo" prefWidth="320.0" />

    <Label text="Nombre:" />
    <TextField fx:id="txtNombre" />

    <Label text="Edad (años, de 0 a 30):" />
    <TextField fx:id="txtEdad" />

    <Label text="Peso (kg):" />
    <TextField fx:id="txtPeso" />

    <Label text="Raza (solo perros):" />
    <TextField fx:id="txtRaza" />

    <CheckBox fx:id="chkVacunado" text="Vacunado (solo perros)" />
    <CheckBox fx:id="chkExterior" text="Vive en el exterior (solo gatos)" />

    <Label fx:id="lblError" textFill="red" wrapText="true" />

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancelar" text="Cancelar" onAction="#cancelar" />
        <Button fx:id="btnGuardar" text="Guardar" onAction="#guardar" />
    </HBox>
</VBox>