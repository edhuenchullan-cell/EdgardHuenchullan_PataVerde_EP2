<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="560.0" prefWidth="950.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.duoc.pataverde.controller.MainController">
    <top>
        <VBox spacing="10.0">
            <padding><Insets top="15.0" right="15.0" bottom="10.0" left="15.0" /></padding>
            <Label text="Clínica Veterinaria PataVerde" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Buscar:" />
                <TextField fx:id="txtBuscar" promptText="Nombre o tipo (Perro / Gato)" prefWidth="300.0" />
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox spacing="6.0" prefWidth="260.0">
            <padding><Insets right="15.0" left="15.0" /></padding>
            <Label text="Registrar mascota" style="-fx-font-size: 15px; -fx-font-weight: bold;" />

            <Label text="Tipo:" />
            <ComboBox fx:id="cmbTipo" promptText="Seleccione..." onAction="#cambiarTipo" maxWidth="Infinity" />

            <Label text="Nombre:" />
            <TextField fx:id="txtNombre" />

            <Label text="Edad (años, de 0 a 30):" />
            <TextField fx:id="txtEdad" />

            <Label text="Peso (kg):" />
            <TextField fx:id="txtPeso" />

            <Label text="Raza (perro):" />
            <TextField fx:id="txtRaza" />

            <CheckBox fx:id="chkVacunado" text="Vacunado (perro)" />
            <CheckBox fx:id="chkAdopcion" text="Disponible para adopción (perro)" />
            <CheckBox fx:id="chkExterior" text="Vive en exterior (gato)" />

            <Button fx:id="btnRegistrar" text="Registrar" onAction="#registrar" maxWidth="Infinity" />
        </VBox>
    </left>

    <center>
        <TableView fx:id="tblMascotas">
            <columns>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="90.0" />
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150.0" />
                <TableColumn fx:id="colEdad" text="Edad" prefWidth="80.0" />
                <TableColumn fx:id="colPeso" text="Peso (kg)" prefWidth="90.0" />
                <TableColumn fx:id="colCosto" text="Costo consulta" prefWidth="130.0" />
            </columns>
            <BorderPane.margin><Insets right="15.0" /></BorderPane.margin>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <padding><Insets top="10.0" right="15.0" bottom="15.0" left="15.0" /></padding>
            <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminar" />
            <Label fx:id="lblMensaje" />
        </HBox>
    </bottom>
</BorderPane>